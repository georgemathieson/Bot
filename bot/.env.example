# Teams bot - the bot's OWN Entra app registration (also the Azure Bot's Microsoft App ID).
# See docs/azure-setup.md, step 2.

# Application (client) ID of the bot app registration
CLIENT_ID=00000000-0000-0000-0000-000000000000
# Client secret of the bot app registration (used for Bot Framework auth AND for the OBO call)
CLIENT_SECRET=
# Directory (tenant) ID - the bot is single-tenant
TENANT_ID=00000000-0000-0000-0000-000000000000

# Application ID URI the bot exposes for Teams SSO. Optional - defaults to api://botid-<CLIENT_ID>.
# Must equal: app reg "Expose an API" URI == manifest webApplicationInfo.resource == OAuth connection "Token Exchange URL".
# BOT_APP_ID_URI=api://botid-00000000-0000-0000-0000-000000000000
# Scope the bot exposes for Teams SSO. Default: access_as_user
# BOT_SSO_SCOPE=access_as_user

# Name of the OAuth connection on the Azure Bot resource (Configuration > OAuth Connection Settings).
OAUTH_CONNECTION_NAME=sso

# The downstream API the bot calls on behalf of the user.
DOWNSTREAM_API_URL=http://localhost:5000/api/me
# Delegated scope(s) of the downstream API's app registration (space or comma separated).
DOWNSTREAM_API_SCOPES=api://00000000-0000-0000-0000-000000000000/access_as_user

# obo           = bot performs the on-behalf-of exchange itself with MSAL (default)
# token-service = Bot Framework token service performs the exchange via the OAuth connection
TOKEN_STRATEGY=obo

# POC only: show decoded token claims and error details on the cards. Set to false for anything real.
SHOW_DIAGNOSTICS=true

PORT=3978
