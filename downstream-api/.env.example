# Downstream API - its OWN Entra app registration (not the bot's).
# See docs/azure-setup.md, step 1.

# Directory (tenant) ID
TENANT_ID=00000000-0000-0000-0000-000000000000

# Application (client) ID of the downstream API app registration
API_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Application ID URI of the downstream API (Expose an API > Application ID URI).
# Optional - defaults to api://<API_CLIENT_ID>. v1 tokens use this as "aud", v2 tokens use the client ID.
# API_APP_ID_URI=api://00000000-0000-0000-0000-000000000000

# Delegated scope the caller must hold (Expose an API > Scopes). Default: access_as_user
# REQUIRED_SCOPE=access_as_user

PORT=5000
