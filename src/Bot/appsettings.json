{
  // The bot's own Entra app registration (also the Azure Bot's Microsoft App ID).
  // Used by the Teams SDK to authenticate Bot Framework traffic AND by the bot for the OBO call.
  // Put the secret in user-secrets, not here:  dotnet user-secrets set "AzureAd:ClientCredentials:0:ClientSecret" "<secret>"
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "<tenant-id>",
    "ClientId": "<bot-client-id>",
    "ClientCredentials": [
      {
        "SourceType": "ClientSecret",
        "ClientSecret": ""
      }
    ]
  },
  "Sso": {
    // Name of the OAuth connection on the Azure Bot resource.
    "OAuthConnectionName": "sso",
    // Optional. Defaults to api://botid-<AzureAd:ClientId>. Must equal the app registration's
    // Application ID URI, the manifest's webApplicationInfo.resource and the connection's Token Exchange URL.
    "BotAppIdUri": "",
    "BotSsoScope": "access_as_user",
    // Obo = the bot runs on-behalf-of itself with MSAL; TokenService = the Bot Framework token service does it.
    "TokenStrategy": "Obo",
    // POC only: show decoded token claims and error details on the cards.
    "ShowDiagnostics": true
  },
  "DownstreamApi": {
    "Url": "http://localhost:5000/api/me",
    "Scopes": [ "api://<downstream-api-client-id>/access_as_user" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Teams": "Information"
    }
  },
  "AllowedHosts": "*"
}
