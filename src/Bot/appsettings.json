{
  // The bot's identity: the Agents SDK service connection. The SDK uses it for Bot Framework traffic.
  // In Azure: the Azure Bot's "Type of App" is User-Assigned Managed Identity. AuthType is UserManagedIdentity and
  // ClientId is the client ID of that managed identity. There is no secret.
  // On your computer there is no managed identity: use a Single Tenant app registration with a secret instead:
  //   dotnet user-secrets set "Connections:ServiceConnection:Settings:AuthType" "ClientSecret"
  //   dotnet user-secrets set "Connections:ServiceConnection:Settings:ClientSecret" "<secret>"
  "Connections": {
    "ServiceConnection": {
      "Settings": {
        "AuthType": "UserManagedIdentity",
        "ClientId": "",
        "TenantId": "",
        "Scopes": [ "https://api.botframework.com/.default" ]
      }
    }
  },
  "ConnectionsMap": [
    { "ServiceUrl": "*", "Connection": "ServiceConnection" }
  ],
  // Inbound token validation on /api/messages. Audiences and TenantId default to the service connection above,
  // so the bot's identity is configured once. It is on in every environment; Enabled=false is for tests only.
  "TokenValidation": {
    "Enabled": true
  },
  // Only send replies to Microsoft service URLs (an anti-SSRF control of the Agents SDK; off by default).
  "OutboundHostValidator": {
    "Enabled": true,
    "IncludeDefaultMicrosoftHosts": true
  },
  "AgentApplication": {
    "StartTypingTimer": false,
    "RemoveRecipientMention": false,
    "NormalizeMentions": false
  },
  // Not a second identity: the app registration that Teams SSO targets (manifest webApplicationInfo.id) and that
  // makes the OBO request. A managed identity can't expose an API scope, so Teams SSO needs an app registration.
  // It trusts the bot's managed identity (the service connection's ClientId) through a federated identity credential,
  // and the bot uses that identity as its credential: nothing else to configure, no secret.
  // Leave ClientId empty to use the service connection's app registration and secret (single app, on your computer).
  "SsoApp": {
    "ClientId": ""
  },
  "Sso": {
    // Name of the OAuth connection on the Azure Bot resource.
    "OAuthConnectionName": "sso",
    // Optional. Defaults to api://botid-<SSO app client ID>. Must equal the SSO app registration's
    // Application ID URI, the manifest's webApplicationInfo.resource and the connection's Token Exchange URL.
    "BotAppIdUri": "",
    "BotSsoScope": "access_as_user",
    // Obo = the bot runs on-behalf-of itself with MSAL; TokenService = the Bot Framework token service does it.
    "TokenStrategy": "Obo",
    // POC only: show decoded token claims and error details on the cards.
    "ShowDiagnostics": true
  },
  "DownstreamApi": {
    "Url": "http://localhost:5000/api/me",
    "Scopes": [ "api://<downstream-api-client-id>/access_as_user" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Agents": "Information"
    }
  },
  "AllowedHosts": "*"
}
