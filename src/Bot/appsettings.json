{
  // The Azure Bot's identity. The Teams SDK uses it for Bot Framework traffic (inbound and outbound).
  // In Azure: the Azure Bot's "Type of App" is User-Assigned Managed Identity, and ClientId is the client ID of
  // that managed identity. There are no ClientCredentials, so the SDK gets its tokens from the managed identity.
  // On your computer there is no managed identity: use a Single Tenant app registration and add its secret with
  //   dotnet user-secrets set "AzureAd:ClientCredentials:0:SourceType" "ClientSecret"
  //   dotnet user-secrets set "AzureAd:ClientCredentials:0:ClientSecret" "<secret>"
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "",
    "ClientId": ""
  },
  // Not a second identity: the app registration that Teams SSO targets (manifest webApplicationInfo.id) and that
  // makes the OBO request. A managed identity can't expose an API scope, so Teams SSO needs an app registration.
  // It trusts the bot's managed identity (AzureAd:ClientId) through a federated identity credential, and the bot
  // uses that identity as its credential: nothing else to configure, no secret.
  // Leave ClientId empty to use the AzureAd app registration and its secret (single app, on your computer).
  "SsoApp": {
    "ClientId": ""
  },
  "Sso": {
    // Name of the OAuth connection on the Azure Bot resource.
    "OAuthConnectionName": "sso",
    // Optional. Defaults to api://botid-<SSO app client ID>. Must equal the SSO app registration's
    // Application ID URI, the manifest's webApplicationInfo.resource and the connection's Token Exchange URL.
    "BotAppIdUri": "",
    "BotSsoScope": "access_as_user",
    // Obo = the bot runs on-behalf-of itself with MSAL; TokenService = the Bot Framework token service does it.
    "TokenStrategy": "Obo",
    // POC only: show decoded token claims and error details on the cards.
    "ShowDiagnostics": true
  },
  "DownstreamApi": {
    "Url": "http://localhost:5000/api/me",
    "Scopes": [ "api://<downstream-api-client-id>/access_as_user" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Teams": "Information"
    }
  },
  "AllowedHosts": "*"
}
