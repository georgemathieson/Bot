{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.20/MicrosoftTeams.schema.json",
  "manifestVersion": "1.20",
  "version": "1.0.0",
  "id": "${{TEAMS_APP_ID}}",
  "developer": {
    "name": "Contoso POC",
    "websiteUrl": "https://example.com",
    "privacyUrl": "https://example.com/privacy",
    "termsOfUseUrl": "https://example.com/terms"
  },
  "name": {
    "short": "SSO OBO POC",
    "full": "Teams SSO + on-behalf-of POC"
  },
  "description": {
    "short": "Adaptive Card action that calls an API as the user, silently.",
    "full": "Demonstrates Adaptive Card Universal Actions (Action.Execute) with Teams single sign-on and the Entra ID on-behalf-of flow to call a protected downstream API as the signed-in user, without a sign-in popup."
  },
  "icons": {
    "outline": "outline.png",
    "color": "color.png"
  },
  "accentColor": "#5558AF",
  "bots": [
    {
      "botId": "${{BOT_ID}}",
      "scopes": ["personal", "team", "groupChat"],
      "isNotificationOnly": false,
      "supportsCalling": false,
      "supportsVideo": false,
      "supportsFiles": false
    }
  ],
  "validDomains": ["*.botframework.com"],
  "webApplicationInfo": {
    "id": "${{SSO_APP_ID}}",
    "resource": "${{BOT_APP_ID_URI}}"
  }
}
